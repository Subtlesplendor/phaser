.{
    .name = .phaser,
    .version = "0.0.0",
    .fingerprint = 0x600e59735a5c8b4c, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .minish = .{
            .url = "https://github.com/CogitatorTech/minish/archive/refs/tags/v0.3.0.tar.gz",
