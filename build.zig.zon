        },
        // Mutation-testing client, recorded in decision 0005. Lazy, so no
        // ordinary build, pull-request job, or offline checkout resolves it;
        // only `zig build mutation` fetches it.
        .zentinel = .{
            .url = "https://github.com/oly-wan-kenobi/zentinel/archive/refs/tags/v0.1.0.tar.gz",
            .hash = "zentinel-0.1.0-5AYzkNjbFgACOK2B2Jy_5KWt33VnlrhNKIiC52b2R8xh",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "test",
        "examples",
        "tools",
    },
}
